{
  "pluginAlias": "SiemensRDS",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Siemens RDS110/RDS120 smart thermostats via the Siemens Climatix IC cloud.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Siemens RDS"
      },
      "email": {
        "title": "Siemens app e-mail",
        "type": "string",
        "format": "email"
      },
      "password": {
        "title": "Siemens app password",
        "type": "string",
        "x-schema-form": {
          "type": "password"
        }
      },
      "apiKey": {
        "title": "Climatix API key (Ocp-Apim-Subscription-Key)",
        "type": "string",
        "description": "32-character key used by the Siemens Smart Thermostat RDS app.",
        "x-schema-form": {
          "type": "password"
        }
      },
      "awaySwitch": {
        "title": "Show a separate Away switch",
        "type": "boolean",
        "default": true
      },
      "pollInterval": {
        "title": "Polling interval (seconds)",
        "type": "integer",
        "default": 60,
        "minimum": 30,
        "maximum": 600
      },
      "devices": {
        "title": "Thermostat names (optional)",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "plantId": {
              "title": "Siemens room name (or plant ID)",
              "type": "string",
              "description": "The room name exactly as in the Siemens app, e.g. \"1st Floor\". Shown in the Homebridge log at startup."
            },
            "name": {
              "title": "Name in HomeKit",
              "type": "string"
            },
            "exclude": {
              "title": "Hide from HomeKit",
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "plantId"
          ]
        },
        "description": "Rename or hide thermostats before they are added to HomeKit. By default each thermostat is named after its room in the Siemens app."
      }
    },
    "required": [
      "name",
      "email",
      "password",
      "apiKey"
    ]
  }
}
